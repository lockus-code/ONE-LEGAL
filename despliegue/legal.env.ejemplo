# /etc/caddy/legal.env — valores del sitio (NO subir al repositorio con datos reales).
# Después de editarlo:  sudo systemctl reload caddy

# Dominio o subdominio que apunta a la IP del servidor (registro DNS tipo A).
# Sin dominio propio, para el piloto puede usar sslip.io: si la IP es 203.0.113.10 → 203-0-113-10.sslip.io
LEGAL_DOMINIO=legal.ejemplo.pe

# Correo para los avisos de Let's Encrypt (vencimiento del certificado).
LEGAL_CORREO_ACME=sistemas@ejemplo.pe

# IP públicas (o rangos CIDR) desde las que se permite el acceso, separadas por espacio.
# Averígüela desde la red institucional en https://ifconfig.me
LEGAL_IPS_PERMITIDAS=203.0.113.10/32

# Los usuarios del portal NO van aquí: van en /etc/caddy/legal-usuarios (ver legal-usuarios.ejemplo).
