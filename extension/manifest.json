{
  "manifest_version": 3,
  "name": "LEGAL · Conector SGD",
  "short_name": "LEGAL SGD",
  "version": "0.3.0",
  "description": "Lector institucional de trámites del SGD para vincularlos a procesos legales en LEGAL, desde el panel lateral de Chrome. Solo lectura.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "declarativeContent",
    "sidePanel"
  ],
  "host_permissions": [
    "https://sgd.sedapar.com.pe/*",
    "http://localhost:8790/*",
    "http://127.0.0.1:8790/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LEGAL · Conector SGD: abre el panel lateral (requiere sesión activa en el SGD)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
